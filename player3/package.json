{
    "name": "player3",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "serve": "rsbuild dev",
        "build": "tsc -b && rsbuild build",
        "format": "biome format --write .",
        "lint": "biome lint .",
        "check": "biome check .",
        "generate-types": "openapi-typescript ../openapi/components.yaml -o src/types.ts --root-types --root-types-no-schema-prefix",
        "generate-schemas": "node ../openapi/extract-schemas.js",
        "test": "rstest watch",
        "test-once": "rstest"
    },
    "dependencies": {
        "@fortawesome/free-solid-svg-icons": "^7.2.0",
        "@mantine/hooks": "^9.5",
        "@react-three/drei": "^10.0.4",
        "@react-three/fiber": "^9.6.1",
        "@shish2k/react-faicon": "^0.1.0",
        "@shish2k/react-mqtt": "^0.1.0",
        "@shish2k/react-use-servertime": "^0.1.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-router-dom": "^7.18.2",
        "react-screen-wake-lock": "^3.0.4",
        "three": "^0.185.1",
        "tinyduration": "^3.4.1",
        "usehooks-ts": "^3.1.1"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.6",
        "@rsbuild/core": "^2.1.9",
        "@rsbuild/plugin-react": "^2.0.0",
        "@rsbuild/plugin-sass": "^2.0.1",
        "@rstest/core": "^0.11.5",
        "@types/node": "^26.1",
        "@types/react": "^19.2.16",
        "@types/react-dom": "^19.0.4",
        "@types/three": "^0.185.1",
        "js-yaml": "^5.2.2",
        "jsdom": "^30.0.1",
        "openapi-typescript": "git+https://github.com/shish/openapi-typescript.git?subdirectory=packages/openapi-typescript#ts7",
        "timezone-mock": "^1.3.6",
        "typescript": "^7.0"
    }
}
